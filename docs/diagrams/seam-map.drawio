        </mxCell>
        <mxCell id="subheading" value="Each seam declares an input surface, invariants and an executable test suite. Seams 1–4 also have dedicated contract files; seams 5–8 live with their subsystem tests." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8190a4;fontSize=15;fontFamily=Verdana;align=left;verticalAlign=middle;" vertex="1" parent="1">
