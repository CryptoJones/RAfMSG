        </mxCell>
        <mxCell id="label2" value="Total: 114 tests across 17 integration test files, all runnable headlessly with cargo test." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8190a4;fontSize=15;fontStyle=0;fontFamily=Verdana;align=left;verticalAlign=middle;" vertex="1" parent="1">
