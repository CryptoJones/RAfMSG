        </mxCell>
        <mxCell id="label1" value="The harness reserves a slot for every seam; its seam_templates() entries are placeholders — real coverage is in the named test files." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8190a4;fontSize=15;fontStyle=0;fontFamily=Verdana;align=left;verticalAlign=middle;" vertex="1" parent="1">
