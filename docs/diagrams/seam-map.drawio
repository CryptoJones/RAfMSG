        <mxCell id="label0" value="cyan = reference-core contract      green = subsystem contract      amber = contract test file" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8190a4;fontSize=15;fontStyle=0;fontFamily=Verdana;align=left;verticalAlign=middle;" vertex="1" parent="1">
